APP_NAME="Sistema de Horas Complementares"
APP_VERSION=0.1.0
ENVIRONMENT=development

POSTGRES_DB=horas_complementares
POSTGRES_USER=horas_user
POSTGRES_PASSWORD=horas_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://horas_user:horas_password@localhost:5433/horas_complementares

PGADMIN_DEFAULT_EMAIL=admin@fepi.edu.br
PGADMIN_DEFAULT_PASSWORD=admin

# Gere uma chave própria com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-em-producao-gere-uma-nova
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Senha do usuário ROOT criado pelo seed de desenvolvimento
DEFAULT_ROOT_PASSWORD=Root@12345

# Também definem o usuário e a senha do próprio MinIO no docker-compose.yml
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=certificates
MINIO_SECURE=false
UPLOAD_MAX_SIZE_MB=10
# Só é necessário quando a API roda em container (o docker-compose já define)
# MINIO_PUBLIC_ENDPOINT=localhost:9000

CORS_ORIGINS=http://localhost:5500
